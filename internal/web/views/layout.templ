package views

// Base layout for the admin UI
templ Layout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="zh-CN" data-theme="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - agent-relay</title>
		<link rel="stylesheet" href={ "/style.css?v=" + assetVersion }/>
		<script src={ "/vendor/htmx.min.js?v=" + assetVersion } defer></script>
		<script src={ "/htmx-config.js?v=" + assetVersion } defer></script>
	</head>
	<body>
		<div id="app" class="app">
			@Sidebar()
			<div class="main-col">
				<header class="topbar">
					<button class="btn-icon" id="menuBtn" aria-label="菜单">
						<svg class="icon"><use href="#i-menu"></use></svg>
					</button>
					<div class="topbar-title">
						<h1 id="pageTitle">{ title }</h1>
						<p id="pageDesc" class="muted xs"></p>
					</div>
					<div class="topbar-right">
						<button class="btn-icon" id="themeToggle" aria-label="切换主题">
							<svg class="icon"><use href="#i-sun"></use></svg>
						</button>
					</div>
				</header>
				<main>
					@content
				</main>
			</div>
		</div>
		@Icons()
		<div id="toasts" class="toast-container" aria-live="polite"></div>
		<script src={ "/app-minimal.js?v=" + assetVersion }></script>
	</body>
	</html>
}

// Sidebar navigation
templ Sidebar() {
	<aside class="sidebar" id="sidebar">
		<div class="sb-brand">
			<div class="logo">AR</div>
			<div class="sb-brand-text">
				<strong>agent-relay</strong>
				<span id="sbVer" class="muted xs">—</span>
			</div>
		</div>
		<nav class="sb-nav" aria-label="主导航">
			<div class="sb-group">运行</div>
			<a href="/#members" class="sb-link">
				<svg class="icon"><use href="#i-users"></use></svg>
				<span>成员</span>
				<em id="navOnline" class="sb-count"></em>
			</a>
			<a href="/#threads" class="sb-link">
				<svg class="icon"><use href="#i-message"></use></svg>
				<span>消息线程</span>
				<em id="navPending" class="sb-count warn" hidden></em>
			</a>
			<a href="/admin/command" class="sb-link active">
				<svg class="icon"><use href="#i-send"></use></svg>
				<span>指挥台</span>
				<em id="navInbox" class="sb-count warn" hidden></em>
			</a>
			<div class="sb-group">接入</div>
			<a href="/#prompts" class="sb-link">
				<svg class="icon"><use href="#i-user-plus"></use></svg>
				<span>邀请 &amp; Prompt</span>
			</a>
			<div class="sb-group">安全</div>
			<a href="/#audit" class="sb-link">
				<svg class="icon"><use href="#i-scroll"></use></svg>
				<span>审计日志</span>
			</a>
			<a href="/#tokens" class="sb-link">
				<svg class="icon"><use href="#i-key"></use></svg>
				<span>Token 管理</span>
			</a>
			<div class="sb-group">系统</div>
			<a href="/#system" class="sb-link">
				<svg class="icon"><use href="#i-server"></use></svg>
				<span>策略 &amp; 更新</span>
			</a>
		</nav>
		<div class="sb-foot">
			<div class="sb-meta">
				<span title="消息最大序号">
					<svg class="icon xs"><use href="#i-hash"></use></svg>
					<b id="sbSeq">-</b>
				</span>
				<span title="数据库体积">
					<svg class="icon xs"><use href="#i-db"></use></svg>
					<b id="sbDb">-</b>
				</span>
			</div>
		</div>
	</aside>
	<div class="sb-scrim" id="sbScrim"></div>
}

// SVG icon sprite (minimal set for conversations)
templ Icons() {
	<svg style="display:none">
		<defs>
			<symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
				<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
			</symbol>
			<symbol id="i-message" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
			</symbol>
			<symbol id="i-user-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
				<circle cx="8.5" cy="7" r="4"></circle>
				<line x1="20" y1="8" x2="20" y2="14"></line>
				<line x1="23" y1="11" x2="17" y2="11"></line>
			</symbol>
			<symbol id="i-scroll" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M8 2v4"></path>
				<path d="M12 2v4"></path>
				<path d="M16 2v4"></path>
				<rect x="3" y="4" width="18" height="18" rx="2"></rect>
				<path d="M3 10h18"></path>
			</symbol>
			<symbol id="i-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="7.5" cy="15.5" r="5.5"></circle>
				<path d="m21 2-9.6 9.6"></path>
				<path d="m15.5 7.5 3 3L22 7l-3-3"></path>
			</symbol>
			<symbol id="i-server" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
				<rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
				<line x1="6" y1="6" x2="6.01" y2="6"></line>
				<line x1="6" y1="18" x2="6.01" y2="18"></line>
			</symbol>
			<symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="3" y1="12" x2="21" y2="12"></line>
				<line x1="3" y1="6" x2="21" y2="6"></line>
				<line x1="3" y1="18" x2="21" y2="18"></line>
			</symbol>
			<symbol id="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="5"></circle>
				<line x1="12" y1="1" x2="12" y2="3"></line>
				<line x1="12" y1="21" x2="12" y2="23"></line>
				<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
				<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
				<line x1="1" y1="12" x2="3" y2="12"></line>
				<line x1="21" y1="12" x2="23" y2="12"></line>
				<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
				<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
			</symbol>
			<symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="12" y1="5" x2="12" y2="19"></line>
				<line x1="5" y1="12" x2="19" y2="12"></line>
			</symbol>
			<symbol id="i-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="23 4 23 10 17 10"></polyline>
				<polyline points="1 20 1 14 7 14"></polyline>
				<path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
			</symbol>
			<symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</symbol>
			<symbol id="i-send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="22" y1="2" x2="11" y2="13"></line>
				<polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
			</symbol>
			<symbol id="i-hash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<line x1="4" y1="9" x2="20" y2="9"></line>
				<line x1="4" y1="15" x2="20" y2="15"></line>
				<line x1="10" y1="3" x2="8" y2="21"></line>
				<line x1="16" y1="3" x2="14" y2="21"></line>
			</symbol>
			<symbol id="i-db" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
				<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
			</symbol>
		</defs>
	</svg>
}
