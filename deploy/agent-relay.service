[Unit]
Description=agent-relay — AI assistant message relay
Documentation=https://github.com/AlixWang/agent-relay
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=agent-relay
Group=agent-relay
ExecStartPre=/bin/mkdir -p /var/lib/agent-relay
ExecStartPre=/bin/chown agent-relay:agent-relay /var/lib/agent-relay
ExecStart=/usr/local/bin/agent-relay -config /etc/agent-relay/config.toml
Restart=always
RestartSec=5
# SQLite on local disk only; hardening:
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-relay
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
