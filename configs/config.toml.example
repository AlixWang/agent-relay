# agent-relay configuration. See docs/CONFIG.md for field reference.
# Copy to /etc/agent-relay/config.toml on the server.

# "auto" = bind the Tailscale IPv4 (tailscale ip -4), fallback 127.0.0.1.
# Any other value is used verbatim, e.g. "127.0.0.1" or "0.0.0.0" (public only).
listen_addr = "auto"
port = 18789
data_dir = "/var/lib/agent-relay"

# Public HTTPS mode. Requires tls_cert + tls_key (Let's Encrypt or provided).
# Never expose plain HTTP on a public interface (DESIGN §7.3).
public = false
tls_cert = ""
tls_key = ""

# 反代共存（caddy/nginx/traefik 在前终止 TLS）。与 public 互斥。
# 此时 relay 只听本机明文，对外地址走 public_addr（onboarding prompt
# 与 serverAddr 播报用它）；admin cookie 照样 Secure；X-Forwarded-For
# 只信任 trusted_proxy 网段（默认仅本机）。
behind_proxy = false
public_addr = ""        # 如 https://relay.example.com（behind_proxy=true 必填）
trusted_proxy = ""      # 允许设 XFF 的 CIDR，空=127.0.0.1/32

# bcrypt hash for the admin UI session login. Generate with:
#   agent-relay -hash 'your-strong-password'
# If empty, the server prints a one-time random password on startup
# (lost on restart — set a real hash for production).
admin_password_hash = ""

# Protocol contract (DESIGN §8.5).
protocol = 1
min_client = 1

# Presence & verification (DESIGN §4.5, §8.4).
online_timeout_secs = 300
verify_timeout_secs = 600

# Guard fuses (DESIGN §6.1).
fuse_max_messages = 500
fuse_max_age_secs = 86400
rate_per_minute = 60
# Deterministic task admission (Phase 3): peers may delegate tasks to other
# peers; set require_task_approval_from_peers=true to hold peer→peer tasks for
# the operator's approval. Peer→operator/system and operator/system tasks are
# never gated.
allow_peer_tasks = true
require_task_approval_from_peers = false

# Permission handshake (DESIGN §6.5): execution-time remote approval.
max_open_permissions = 10
progress_throttle_secs = 10
permission_ttl_secs = 600

# Retention (DESIGN §10.2).
message_ttl_days = 30
peer_prune_after_days = 7
audit_retention_days = 90

# Agent runtime diagnostics (DESIGN §4.11): separate from audit. Clients
# batch-upload through POST /logs; the table is pruned by age and capped per
# peer. 0 disables age pruning / row cap; the rate must be >= 1.
agent_log_retention_days = 30
agent_log_rate_per_minute = 60
agent_log_max_rows_per_peer = 20000

# Optional generic POST webhook for peer offline transitions:
# {"peer_id": "...", "offline_secs": 1234, "ts": 1728...}
offline_webhook_url = ""

# Max request body bytes (default 1 MiB).
max_body_bytes = 1048576

# Self-service resource registration (ADR 0006). Active assistants may submit
# secret/mcp/skill/prompt resources into a review queue; an operator must
# approve before anything enters the live resource hub or is grantable.
resource_self_registration = true
resource_pending_max_per_peer = 20
resource_live_max_per_peer = 100
resource_submit_per_hour = 10
resource_pending_ttl_days = 30
resource_notify_batch_secs = 600

# SSE push (DESIGN §4.4b): outbound-only event stream for assistants that
# can hold a persistent process (relay-tail.sh). Short polling stays default.
stream_keepalive_secs = 20
stream_max_per_peer = 3

# Assistant profile (DESIGN §8.7): heartbeat nudges a refresh when the
# self-intro is older than this. 0 disables the nudge.
profile_refresh_days = 7

# Rooms (DESIGN §6.8): group chat from the console rides the normal message
# path. A room is one long-lived thread, so its cap is a rolling window rather
# than the whole-thread fuse that 1:1 threads use.
max_room_members = 16
room_fuse_max_messages = 60
room_fuse_window_secs = 3600

# Muse account authorization + keepalive (DESIGN §4.9). Optional: with no
# authorized accounts these settings cause no outbound traffic. The console's
# Muse page binds one muse.ai account per member; the server renews
# /api/session and keeps the sandbox VM warm via /api/hatch/vm/wake.
# 0 disables the background loop (manual buttons still work).
muse_keepalive_secs = 900
# 0 selects the default 300s; otherwise must be >= 60.
muse_wake_cooldown_secs = 300
muse_http_timeout_secs = 12
muse_auto_wake = true
# Production must use https. http is accepted only for loopback test servers.
muse_base_url = "https://muse.ai"
# Optional outbound proxy (muse.ai blocked / fixed egress needed).
# Empty = honour HTTPS_PROXY from the service environment.
muse_proxy_url = ""
